doctype html
html
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    title Pantry Notes | Recipes worth keeping
    link(rel='preconnect', href='https://fonts.googleapis.com')
    link(rel='preconnect', href='https://fonts.gstatic.com', crossorigin)
    link(href='https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap', rel='stylesheet')
    link(rel='stylesheet', href='/stylesheets/style.css')
  body
    header.site-header
      nav.site-nav(aria-label='Primary navigation')
        a.brand(href='/recipes')
          span.brand-mark P
          span Pantry Notes
        .nav-links
          a(href='/recipes') Browse recipes
          if user
            a.button.button-small(href='/recipes/new') Add a recipe
            a.account-link(href='/auth/logout') Sign out
          else
            a(href='/auth/login') Sign in
            a.button.button-small(href='/auth/register') Join the table
    
    main.container
      if error && error.length > 0
        p.flash.flash-error(role='alert')= error
      if success_msg && success_msg.length > 0
        p.flash.flash-success(role='status')= success_msg
      block content
    footer.site-footer
      p A small collection of recipes worth returning to.
