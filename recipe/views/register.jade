extends layout

block content
  h2 Register
  form(action="/auth/register", method="POST")
    div
      label Username:
      input(type="text", name="username", required)
    div
      label Email:
      input(type="email", name="email", required)
    div
      label Password:
      input(type="password", name="password", required)
    button(type="submit") Register